#!/usr/bin/env bash
set -euo pipefail

source_ref="${1:-$(git branch --show-current)}"
upstream_ref="${2:-$(git symbolic-ref --quiet --short refs/remotes/upstream/HEAD)}"
repository_root="$(git rev-parse --show-toplevel)"
repository_name="$(basename "$repository_root")"
patch_file="${3:-$(mktemp "${TMPDIR:-/tmp}/${repository_name}-upstream.XXXXXX.patch")}"
origin_url="$(git remote get-url origin)"
upstream_url="$(git remote get-url upstream)"

if [[ -z "$source_ref" || -z "$upstream_ref" ]]; then
  echo "Usage: scripts/prepare-upstream-branch [source-ref] [upstream-ref] [patch-file]" >&2
  exit 1
fi

git rev-parse --verify --quiet "${source_ref}^{commit}" >/dev/null
git rev-parse --verify --quiet "${upstream_ref}^{commit}" >/dev/null

pathspec=(.)
if [[ "$origin_url" != "$upstream_url" ]]; then
  pathspec+=(
    ":(exclude)context/**"
    ":(exclude)AGENTS.md"
    ":(exclude)CLAUDE.md"
    ":(exclude).githooks/pre-push"
    ":(exclude)scripts/prepare-upstream-branch"
  )
fi

git diff --binary "${upstream_ref}...${source_ref}" -- "${pathspec[@]}" > "$patch_file"

if [[ ! -s "$patch_file" ]]; then
  echo "No publishable changes found between $upstream_ref and $source_ref." >&2
  exit 1
fi

git apply --check --whitespace=nowarn "$patch_file"
echo "Publication patch ready: $patch_file"
echo "Apply it only to the official upstream branch created by the destination workflow."
