# Estado local que todos los worktrees deben compartir con el checkout principal.
#
# Las rutas terminadas en `/` son raices administradas: el hook las crea en el
# checkout principal cuando no existen y enlaza el directorio completo. Las
# rutas con comodines y los ficheros solo se enlazan cuando ya existen.
# Nunca se incluyen contenidos ni valores secretos en este manifiesto.

# Credenciales
.env
.env.*
gcp_sa_key.json
secrets/

# Datos y modelos
data/
data-*/
models/
tests/data/
tests/models/

# Prototipos
prototypes/*/.env
prototypes/*/data/
prototypes/*/data-*/
