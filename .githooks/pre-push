#!/usr/bin/env bash
set -euo pipefail

# Guardian de publicacion hacia upstream.
#
# Bloquea cualquier push a `upstream` cuya historia saliente introduzca rutas
# personales, cuando `origin` y `upstream` son repositorios distintos.
#
# La comparacion de remotos se hace sobre URLs NORMALIZADAS. Un mismo
# repositorio puede escribirse de varias formas equivalentes
# (git@github.com-alias:usuario/repo.git y https://github.com/usuario/repo.git),
# y compararlas como texto plano daria una separacion falsa.

normalize_remote() {
  local u="${1:-}"
  u="${u%.git}"
  u="${u#https://}"; u="${u#http://}"; u="${u#ssh://}"
  u="${u#*@}"
  u="${u/:/\/}"
  u="$(printf '%s' "$u" | sed -E 's#^([a-zA-Z0-9.]+\.[a-z]+)-[A-Za-z0-9_-]+/#\1/#')"
  printf '%s' "$u" | tr 'A-Z' 'a-z'
}

remote_name="$1"
remote_url="$2"
origin_url="$(git remote get-url origin 2>/dev/null || true)"
upstream_url="$(git remote get-url upstream 2>/dev/null || true)"

# Solo interviene si el destino es upstream.
if [[ "$remote_name" != "upstream" && "$(normalize_remote "$remote_url")" != "$(normalize_remote "$upstream_url")" ]]; then
  exit 0
fi

# Si origin y upstream son el mismo repositorio, no hay frontera que proteger.
if [[ "$(normalize_remote "$origin_url")" == "$(normalize_remote "$upstream_url")" ]]; then
  exit 0
fi

private_paths=(
  context
  AGENTS.md
  CLAUDE.md
  .githooks
  scripts/prepare-upstream-branch
)
zero_oid="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" == "$zero_oid" ]] && continue

  if [[ "$remote_oid" == "$zero_oid" ]]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi

  while read -r commit; do
    if git diff-tree --no-commit-id --name-only -r --root "$commit" -- "${private_paths[@]}" | grep -q .; then
      echo "Push a upstream bloqueado: $local_ref introduce rutas personales en el commit $commit." >&2
      echo "Cuando origin y upstream son distintos, el contenido personal vive solo en origin." >&2
      echo "Prepara un parche limpio con scripts/prepare-upstream-branch." >&2
      blocked=1
      break
    fi
  done < <(git rev-list "$range")
done

exit "$blocked"

