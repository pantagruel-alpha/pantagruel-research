#!/usr/bin/env bash
set -euo pipefail

remote_name="$1"
remote_url="$2"
origin_url="$(git remote get-url origin)"
upstream_url="$(git remote get-url upstream)"

if [[ "$remote_name" != "upstream" && "$remote_url" != "$upstream_url" ]]; then
  exit 0
fi

if [[ "$origin_url" == "$upstream_url" ]]; then
  exit 0
fi

private_paths=(
  context
  AGENTS.md
  CLAUDE.md
  .githooks/pre-push
  scripts/prepare-upstream-branch
)
zero_oid="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" == "$zero_oid" ]] && continue

  if [[ "$remote_oid" == "$zero_oid" ]]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi

  while read -r commit; do
    if git diff-tree --no-commit-id --name-only -r --root "$commit" -- "${private_paths[@]}" | grep -q .; then
      echo "Blocked push to upstream: $local_ref includes personal paths in commit $commit." >&2
      echo "Personal paths belong only in origin when origin and upstream differ." >&2
      echo "Prepare a clean patch with scripts/prepare-upstream-branch." >&2
      blocked=1
      break
    fi
  done < <(git rev-list "$range")
done

exit "$blocked"
