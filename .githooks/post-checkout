#!/usr/bin/env bash
set -euo pipefail

# Conserva la delegacion a Git LFS cuando core.hooksPath apunta aqui.
if git config --get filter.lfs.clean >/dev/null 2>&1; then
  if ! command -v git-lfs >/dev/null 2>&1; then
    echo "Este repositorio usa Git LFS pero 'git-lfs' no esta en el PATH." >&2
    exit 2
  fi
  git lfs post-checkout "$@"
fi

crear_enlace() {
  local origen="$1"
  local destino="$2"

  if command -v powershell.exe >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1; then
    local tipo="SymbolicLink"
    [ -d "$origen" ] && tipo="Junction"

    local origen_win destino_win origen_ps destino_ps
    origen_win="$(cygpath -aw "$origen")"
    destino_win="$(cygpath -aw "$destino")"
    origen_ps="${origen_win//\'/\'\'}"
    destino_ps="${destino_win//\'/\'\'}"

    powershell.exe -NoProfile -NonInteractive -Command \
      "\$ErrorActionPreference = 'Stop'; try { New-Item -ItemType '$tipo' -Path '$destino_ps' -Target '$origen_ps' | Out-Null } catch { if ('$tipo' -ne 'SymbolicLink') { throw }; New-Item -ItemType 'HardLink' -Path '$destino_ps' -Target '$origen_ps' | Out-Null }"
  else
    ln -s "$origen" "$destino"
  fi
}

enlazar_estado_local() {
  local main_raw main_wt current_wt manifiesto
  main_raw="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
  [ -n "$main_raw" ] || return 0

  main_wt="$(cd "$main_raw" && pwd -P)"
  current_wt="$(pwd -P)"
  [ "$main_wt" != "$current_wt" ] || return 0

  manifiesto="$main_wt/.worktreelink"
  [ -f "$manifiesto" ] || return 0

  local linea patron raiz glob origen ruta destino
  while IFS= read -r linea || [ -n "$linea" ]; do
    patron="$(printf '%s' "${linea%%#*}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -n "$patron" ] || continue

    raiz=0
    case "$patron" in
      */) raiz=1; patron="${patron%/}" ;;
    esac

    glob=0
    case "$patron" in
      *[*?[]*) glob=1 ;;
    esac

    if [ "$raiz" = "1" ] && [ "$glob" = "0" ]; then
      mkdir -p "$main_wt/$patron"
    fi

    for origen in "$main_wt"/$patron; do
      [ -e "$origen" ] || continue
      ruta="${origen#"$main_wt"/}"
      destino="$current_wt/$ruta"

      if [ -L "$destino" ]; then
        continue
      fi

      if [ -d "$destino" ] && [ -z "$(find "$destino" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
        rmdir "$destino"
      elif [ -e "$destino" ]; then
        echo "  aviso: no se enlaza '$ruta' porque ya contiene estado local" >&2
        continue
      fi

      mkdir -p "$(dirname "$destino")"
      crear_enlace "$origen" "$destino"
      echo "  compartido  $ruta" >&2
    done
  done < "$manifiesto"
}

# El tercer argumento vale 1 después de materializar una rama o worktree.
if [ "${3:-0}" = "1" ]; then
  enlazar_estado_local

  if [ "${WORKTREELINK_SKIP_SYNC:-0}" != "1" ] &&
     [ -f uv.lock ] && command -v uv >/dev/null 2>&1; then
    echo "  sincronizando entorno..." >&2
    uv sync --quiet || echo "  aviso: 'uv sync' fallo; ejecutalo a mano" >&2
  fi
fi
