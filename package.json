{
  "name": "astrofy",
  "description": "Astrofy is a free and open-source template for your Personal Portfolio Website built with Astro and TailwindCSS. Create in minutes a website with Blog, CV, Project Section, Store and RSS Feed.",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:articles": "node scripts/sync-articles.mjs",
    "prebuild": "npm run sync:articles",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/article-publication/*.test.mjs",
    "astro": "astro",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@astrojs/mdx": "^2.0.3",
    "@astrojs/rss": "^3.0.0",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/tailwind": "^5.0.3",
    "astro": "^4.0.2",
    "daisyui": "^4.4.10",
    "dayjs": "^1.11.9",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "patch-package": "^8.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.4"
  }
}
